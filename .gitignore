# ==========================================
# Terraform Ignore Files
# ==========================================
# Local .terraform directories containing plugins/modules
.terraform/
.terraform.lock.hcl

# State files and backups
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variables files containing credentials (secrets)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc


# ==========================================
# Golang Ignore Files
# ==========================================
# Compiled binaries (in their build directories)
services/user-service/user-service
services/auth-service/auth-service
services/payment-service/payment-service
services/notification-service/notification-service

# Execution binaries and test binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof


# ==========================================
# Frontend/React/Node Ignore Files
# ==========================================
# Dependency directory
services/frontend/node_modules/

# Production build outputs
services/frontend/dist/
services/frontend/build/

# Debug and system logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files (which may contain API keys/secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local


# ==========================================
# Docker & Local Dev Ignored Files
# ==========================================
# Docker storage data volume
docker/pgdata/


# ==========================================
# OS & IDE Ignored Files
# ==========================================
# OS system files
.DS_Store
Thumbs.db

# JetBrains IDE files
.idea/

# Visual Studio Code configurations
.vscode/
*.code-workspace

# Local log files
*.log
